{
  "name": "mathematical-knowledge-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "test": "npm run test --workspace apps/desktop",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run tauri --workspace apps/desktop -- dev",
    "desktop:build": "npm run tauri --workspace apps/desktop -- build",
    "engine:bundle": "uv run python scripts/bundle_engine.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
}
